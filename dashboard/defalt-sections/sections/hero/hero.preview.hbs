{{!-- Hero Split Section (Preview) --}}

{{> "sections/hero/hero.styles"}}

{{#get "pages" filter=tagFilter limit="1" include="tags,authors"}}
  {{#if pages}}
    <section
      class="gd-hero-split gd-hero-split-align-{{textAlignment}}"
      data-section-type="hero"
      data-section-id="{{sectionId}}"
      style="{{sectionStyle}}; --gd-hero-background: {{backgroundColor}}; --gd-hero-content-width: {{contentWidth}}; --gd-hero-padding-x: {{containerPaddingX}}; --gd-hero-image-column: {{imageColumn}}; --gd-hero-text-column: {{textColumn}}; --gd-hero-image-radius: {{imageBorderRadius}}px;{{#if imageAspectRatio}} --gd-hero-image-aspect: {{imageAspectRatio}};{{/if}}"
    >
      <div class="gd-hero-split__inner">
        {{#foreach pages}}
          <div class="gd-hero-split__content{{#if ../imageOnRight}} gd-hero-split__content--image-right{{/if}}">
            <div class="gd-hero-split__image{{#if ../imageAspectRatio}} gd-hero-split__image--fixed{{/if}}">
              {{#if feature_image}}
                <img src="{{img_url feature_image size=\"xl\"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" />
              {{else}}
                <img src="{{#if ../placeholderImageUrl}}{{../placeholderImageUrl}}{{else}}/sections/placeholder.jpg{{/if}}" alt="" />
              {{/if}}
            </div>
            <div class="gd-hero-split__text">
              {{#if ../pageTitle}}
                <h1 class="gd-hero-split__heading">{{title}}</h1>
              {{/if}}
              <p class="gd-hero-split__description">
                {{#if custom_excerpt}}
                  {{custom_excerpt}}
                {{else}}
                  {{#if excerpt}}
                    {{excerpt}}
                  {{/if}}
                {{/if}}
              </p>
              {{#if html}}
                <div class="gd-hero-split__ctas gh-content is-body">
                  {{{html}}}
                </div>
              {{/if}}
            </div>
          </div>
        {{/foreach}}
      </div>
    </section>
  {{else}}
    <section
      class="gd-hero-split gd-hero-split-align-{{textAlignment}}"
      data-section-type="hero"
      data-section-id="{{sectionId}}"
      style="{{sectionStyle}}; --gd-hero-background: {{backgroundColor}}; --gd-hero-content-width: {{contentWidth}}; --gd-hero-padding-x: {{containerPaddingX}}; --gd-hero-image-column: {{imageColumn}}; --gd-hero-text-column: {{textColumn}}; --gd-hero-image-radius: {{imageBorderRadius}}px;{{#if imageAspectRatio}} --gd-hero-image-aspect: {{imageAspectRatio}};{{/if}}"
    >
      <div class="gd-hero-split__inner">
        <div class="gd-hero-split__content{{#if imageOnRight}} gd-hero-split__content--image-right{{/if}}">
          <div class="gd-hero-split__image{{#if imageAspectRatio}} gd-hero-split__image--fixed{{/if}}">
            <img src="{{#if placeholderImageUrl}}{{placeholderImageUrl}}{{else}}/sections/placeholder.jpg{{/if}}" alt="" />
          </div>
          <div class="gd-hero-split__text">
            {{#if pageTitle}}
              <h1 class="gd-hero-split__heading">Hero</h1>
            {{/if}}
            <p class="gd-hero-split__description">Tag a published Ghost page with <code>{{internalTag}}</code>.</p>
          </div>
        </div>
      </div>
    </section>
  {{/if}}
{{/get}}

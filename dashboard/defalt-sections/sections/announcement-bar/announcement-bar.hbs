{{!-- Announcement Bar Section - Engine V2: Block Architecture --}}
{{!-- Content is fetched from Ghost pages using each block's tag --}}

{{> "sections/announcement-bar/announcement-bar.styles"}}

{{#if (length announcements)}}
  <section
    class="announcement-bar{{#if (eq width 'narrow')}} announcement-bar--narrow{{/if}}"
    data-section-type="announcement-bar"
    data-section-id="{{default sectionId 'announcement-bar'}}"
    style="
      {{sectionStyle}};
      --announcement-bar-background-color: {{backgroundColor}};
      --announcement-bar-text-color: {{textColor}};
      --announcement-bar-divider-thickness: {{dividerThickness}}px;
      --announcement-bar-divider-color: {{dividerColor}};
    "
  >
    <div class="announcement-bar__content">
      {{!-- Engine V2: Loop over announcements blocks --}}
      {{!-- Priority: 1) Ghost page content via tag, 2) Manual text --}}
      {{#each announcements}}
        {{#unless @first}}<span class="announcement-bar__separator">·</span>{{/unless}}
        {{#get "pages" filter=tagFilter limit="1" include="tags"}}
          {{#if pages}}
            {{!-- Ghost page content found --}}
            {{#foreach pages}}
              <div
                class="announcement-bar__item"
                style="{{typographyStyle size=../typographySize weight=../typographyWeight spacing=../typographySpacing case=../typographyCase}}"
              >
                {{{html}}}
              </div>
            {{/foreach}}
          {{else}}
            {{!-- No Ghost page - use manual text --}}
            {{#if ../text}}
              <span
                class="announcement-bar__item"
                style="{{typographyStyle size=../typographySize weight=../typographyWeight spacing=../typographySpacing case=../typographyCase}}"
              >{{../text}}</span>
            {{/if}}
          {{/if}}
        {{/get}}
      {{/each}}
    </div>
  </section>
{{/if}}

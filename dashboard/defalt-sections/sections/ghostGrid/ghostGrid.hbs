{{!-- Ghost Grid Section --}}

<style>
.gd-ghost-grid-section {
  width: 100%;
  background-color: var(--gd-ghost-grid-background, transparent);
}

.gd-ghost-grid-section .gh-inner {
  max-width: var(--gd-ghost-grid-content-width, 1120px);
  margin: 0 auto;
  padding: 0 var(--gd-ghost-grid-padding-x, var(--container-gap, 24px));
}

.gd-ghost-grid-inner {
  display: flex;
  flex-direction: column;
}

.gd-ghost-grid-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gd-ghost-grid-gap, 40px);
}

@media (max-width: 768px) {
  .gd-ghost-grid-stack .gd-ghost-grid-grid {
    grid-template-columns: 1fr;
  }
}

.gd-ghost-grid-hide-header .gh-article-header {
  display: none;
}

.gd-ghost-grid-header-left .gh-article-header {
  text-align: left;
}

.gd-ghost-grid-header-center .gh-article-header {
  text-align: center;
}

.gd-ghost-grid-header-right .gh-article-header {
  text-align: right;
}

.gd-ghost-title-small .gh-article-header .gh-article-title {
  font-family: var(--gh-font-heading, var(--font-sans));
  font-size: calc(2.4rem * var(--factor, 1));
  font-weight: 725;
  letter-spacing: -0.015em;
  line-height: 1.1;
}

.gd-ghost-title-normal .gh-article-header .gh-article-title {
  font-family: var(--gh-font-heading, var(--font-sans));
  font-size: calc(clamp(2.8rem, 1.36vw + 2.25rem, 4rem) * var(--factor, 1));
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
}

.gd-ghost-title-large .gh-article-header .gh-article-title {
  font-family: var(--gh-font-heading, var(--font-sans));
  font-size: calc(clamp(3rem, 1.82vw + 2.27rem, 4.6rem) * var(--factor, 1));
  font-weight: 700;
  letter-spacing: -0.028em;
  line-height: 1.1;
}

.gd-ghost-grid-placeholder {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--gd-ghost-grid-gap, 40px);
  opacity: 0.9;
}

.gd-ghost-grid-placeholder-column {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

@media (max-width: 768px) {
  .gd-ghost-grid-stack .gd-ghost-grid-placeholder {
    grid-template-columns: 1fr;
  }
}

.gd-ghost-grid-placeholder-card {
  border: 1px dashed #d4d4d4;
  border-radius: 12px;
  padding: 24px;
  background-color: #fafafa;
  text-align: center;
  color: #6b7280;
}

.gd-ghost-grid-placeholder-title {
  margin-bottom: 8px;
  font-weight: 600;
  color: #151515;
}

.gd-ghost-grid-placeholder-card code {
  display: inline-flex;
  align-items: center;
  padding: 2px 6px;
  margin: 0 2px;
  border-radius: 4px;
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  font-size: 12px;
  font-family: inherit;
}

.gd-ghost-placeholder-header {
  margin-bottom: 0;
  opacity: 0.5;
}

	.gd-ghost-placeholder-header .gh-article-title {
	  color: rgba(21, 21, 21, 0.55);
	}

	.gd-ghost-placeholder-image {
	  width: 100%;
	  height: auto;
	  border-radius: 12px;
	  display: block;
	  margin: 0 auto 12px;
	}
	</style>

{{#get "pages" filter=hideTagFilter limit="1"}}
  {{#if pages}}
    {{!-- Section intentionally hidden via #cards-hide --}}
  {{else}}
	    {{#get "pages" filter=anyTagFilter limit="1" include="tags" as |anyPages|}}
	      {{#if anyPages.[0]}}
	        {{#get "pages" filter=leftTagFilter limit="1" include="tags" as |leftPages|}}
	          {{#get "pages" filter=rightTagFilter limit="1" include="tags" as |rightPages|}}
            <section
              class="gd-ghost-grid-section gh-outer{{#unless pageTitle}} gd-ghost-grid-hide-header{{/unless}} gd-ghost-grid-header-{{textAlignment}} gd-ghost-title-{{titleSize}}{{#if stackOnMobile}} gd-ghost-grid-stack{{/if}}"
              data-section-type="ghost-grid"
              data-section-id="{{sectionId}}"
              style="{{sectionStyle}}; --gd-ghost-grid-background: {{backgroundColor}}; --gd-ghost-grid-content-width: {{contentWidth}}; --gd-ghost-grid-padding-x: {{containerPaddingX}}; --gd-ghost-grid-gap: {{gap}}px;"
            >
              <div class="gh-inner">
                <div class="gd-ghost-grid-inner">
                  {{#if leftPages.[0]}}
                    <div class="gd-ghost-grid-grid">
	                      {{#foreach leftPages}}
	                        <article class="gh-article gd-ghost-card">
	                          <header class="gh-article-header">
	                            <h1 class="gh-article-title is-title">{{title}}</h1>
	                            {{#if custom_excerpt}}
	                              <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
	                            {{/if}}
	                          </header>
                          <div class="gh-content is-body">
                            {{{html}}}
                          </div>
                        </article>
                      {{/foreach}}
	                      {{#if rightPages.[0]}}
	                        {{#foreach rightPages}}
	                          <article class="gh-article gd-ghost-card">
	                            <header class="gh-article-header">
	                              <h1 class="gh-article-title is-title">{{title}}</h1>
	                              {{#if custom_excerpt}}
	                                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
	                              {{/if}}
	                            </header>
                            <div class="gh-content is-body">
                              {{{html}}}
                            </div>
                          </article>
                        {{/foreach}}
                      {{/if}}
                    </div>
                  {{else}}
	                    {{#if rightPages.[0]}}
	                      <div class="gd-ghost-grid-grid">
	                        {{#foreach rightPages}}
	                          <article class="gh-article gd-ghost-card">
	                            <header class="gh-article-header">
	                              <h1 class="gh-article-title is-title">{{title}}</h1>
	                              {{#if custom_excerpt}}
	                                <p class="gh-article-excerpt is-body">{{custom_excerpt}}</p>
	                              {{/if}}
	                            </header>
                            <div class="gh-content is-body">
                              {{{html}}}
                            </div>
                          </article>
                        {{/foreach}}
                      </div>
                    {{/if}}
                  {{/if}}
                </div>
              </div>
	            </section>
	          {{/get}}
	        {{/get}}
	      {{else}}
	        {{#if isPreview}}
	          <section
	            class="gd-ghost-grid-section gh-outer{{#unless pageTitle}} gd-ghost-grid-hide-header{{/unless}} gd-ghost-grid-header-{{textAlignment}} gd-ghost-title-{{titleSize}}{{#if stackOnMobile}} gd-ghost-grid-stack{{/if}}"
	            data-section-type="ghost-grid"
	            data-section-id="{{sectionId}}"
	            style="{{sectionStyle}}; --gd-ghost-grid-background: {{backgroundColor}}; --gd-ghost-grid-content-width: {{contentWidth}}; --gd-ghost-grid-padding-x: {{containerPaddingX}}; --gd-ghost-grid-gap: {{gap}}px;"
	          >
	            <div class="gh-inner">
	              <div class="gd-ghost-grid-inner">
	                <div class="gd-ghost-grid-placeholder">
		                  <div class="gd-ghost-grid-placeholder-column">
		                    <article class="gd-ghost-grid-placeholder-card">
		                      <header class="gh-article-header gd-ghost-placeholder-header">
		                        <h1 class="gh-article-title is-title">Left</h1>
		                      </header>
		                      {{#if placeholderImageUrl}}
		                        <img class="gd-ghost-placeholder-image" src="{{placeholderImageUrl}}" alt="" />
		                      {{/if}}
		                      <div class="gd-ghost-grid-placeholder-title">Tag a published page with <code>{{internalTagLeft}}</code></div>
		                    </article>
		                  </div>
		                  <div class="gd-ghost-grid-placeholder-column">
		                    <article class="gd-ghost-grid-placeholder-card">
		                      <header class="gh-article-header gd-ghost-placeholder-header">
		                        <h1 class="gh-article-title is-title">Right</h1>
		                      </header>
		                      {{#if placeholderImageUrl}}
		                        <img class="gd-ghost-placeholder-image" src="{{placeholderImageUrl}}" alt="" />
		                      {{/if}}
		                      <div class="gd-ghost-grid-placeholder-title">Tag a published page with <code>{{internalTagRight}}</code></div>
		                    </article>
		                  </div>
	                </div>
	              </div>
	            </div>
	          </section>
	        {{/if}}
	      {{/if}}
	    {{/get}}
	  {{/if}}
{{/get}}

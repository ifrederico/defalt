# Ghost CMS connection
VITE_GHOST_URL=https://your-ghost-domain.com

# App configuration
VITE_BASE_PATH=/app/

# Development only: bypass Ghost auth for local testing
# VITE_DEV_BYPASS_AUTH=true

# PostgreSQL connection (for theme storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/defalt

# Server port (production)
# PORT=3000

# AI Section Generator (optional - feature hidden if not set)
# VITE_AI_SERVICE_URL=https://ai.defalt.app
# VITE_AI_API_KEY=your_api_key_here

# Analytics (optional - Umami script only loads in production builds)
# VITE_UMAMI_WEBSITE_ID=your-website-id
# VITE_UMAMI_HOST=https://cloud.umami.is
